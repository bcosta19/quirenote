[Unit]
Description=Quirenote — notas e leitor de PDF/EPUB via web
After=network-online.target

[Service]
ExecStart=%h/.local/bin/quirenote
# Para acessar pela VPN, troque pelo IP do notebook na rede (ex.: `netbird status`).
Environment=QUIRENOTE_ADDR=127.0.0.1:8080
Environment=QUIRENOTE_VAULT=%h/Documents/NotasObsidian/Notas
# Se o IP da VPN ainda não existir no boot, tenta de novo.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
