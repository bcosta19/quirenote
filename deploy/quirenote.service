[Unit]
Description=Quirenote — markdown notes with a PDF/EPUB reader, over the web
After=network-online.target

[Service]
ExecStart=%h/.local/bin/quirenote
# For VPN access, replace it with the machine's IP on the network (e.g. `netbird status`).
Environment=QUIRENOTE_ADDR=127.0.0.1:8080
Environment=QUIRENOTE_VAULT=%h/Documents/NotasObsidian/Notas
# If the VPN IP does not exist yet at boot, retry.

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
