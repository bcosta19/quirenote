[Unit]
Description=Quirenote — Rust backend for the native notes and PDF/EPUB application
After=network-online.target

[Service]
ExecStart=%h/.local/bin/quirenote
# For VPN access, replace it with the machine's IP on the network (e.g. `netbird status`).
Environment=QUIRENOTE_ADDR=127.0.0.1:8080
# The vault comes from ~/.config/quirenote/config.toml (quirenote init <folder>).
# To pin it here instead: Environment=QUIRENOTE_VAULT=%h/Notes
# If the VPN IP does not exist yet at boot, retry.

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
