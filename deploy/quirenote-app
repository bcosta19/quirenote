#!/usr/bin/env bash
# Start the local Rust service when needed, then open the native Rust interface.
set -euo pipefail
url=${QUIRENOTE_URL:-${NOTAS_URL:-http://127.0.0.1:8080}}

ready() { curl --connect-timeout 1 --max-time 2 -fs -o /dev/null "$url/api/setup"; }
if ! ready; then
  if [[ "$url" != "http://127.0.0.1:8080" && "$url" != "http://localhost:8080" ]]; then
    echo "Quirenote: backend unavailable at $url" >&2
    exit 1
  fi
  systemctl --user start quirenote
  for _ in {1..50}; do
    ready && break
    sleep 0.2
  done
  if ! ready; then
    echo "Quirenote: the local backend did not become ready" >&2
    exit 1
  fi
fi
exec quirenote-gui --server "$url" "$@"
